# Copy to .env.local and fill in values there. .env.local is git-ignored; this
# file lists variable names only (empty values). Set URLs, keys, and pins in your
# local .env.local (git-ignored).

# --- Operator (who may change projects) ---
CSP_OPERATOR_ID=
CSP_OPERATOR_TOKEN=
# Hosted origin only: require the gateway header on every request. Leave unset locally.
CSP_REQUIRE_GATEWAY=
# Vercel gateway build only: persistent studio backend HTTPS origin.
CSP_STUDIO_ORIGIN=

# --- Storage: folder holding data/projects (defaults to the repo root) ---
CSP_PROJECT_ROOT=
# Production build only (adapter-node): files dropped on the board upload as the request
# body, and adapter-node caps bodies at 512K by default. Raise it for video, e.g. 2G.
BODY_SIZE_LIMIT=

# --- Agent model provider ---
# Pick providers (Hyper, custom endpoint, Raycast bridge), keys and the app default
# in Settings → Agent model; keys are stored in the app settings file below, never in projects.
# Optional: where that file lives (default: app-settings.json beside CSP_PROJECT_ROOT, never inside it).
CSP_APP_SETTINGS_PATH=
# Optional: Hyper key fallback when none is saved in Settings.
HYPER_API_KEY=
# Fallback default when no app default is picked (OpenAI-compatible).
KIMI_API_KEY=
KIMI_API_BASE=
KIMI_MODEL=

# --- Raycast bridge (optional; operator's personal provider) ---
CSP_RAYCAST_BRIDGE_URL=
CSP_RAYCAST_BRIDGE_TOKEN=
# Legacy names for the two above, still read as fallbacks. Prefer CSP_RAYCAST_BRIDGE_*.
CSP_M3_BRIDGE_URL=
CSP_M3_BRIDGE_TOKEN=

# --- Splitter (scene-detect / grid split service) ---
CSP_SPLITTER_URL=
SPLITTER_APP_ACCESS_PIN=

# --- Settings → capability checks (optional) ---
CSP_DESKTOP_URL=

# --- Sound (optional): local sound-effects folder, used when Settings has none ---
CSP_SFX_DIR=

# --- Public watch site ---
# 1 = this deployment is the public, read-only site (also on automatically on Vercel).
CSP_PUBLIC_SITE=
# Where the public site reads published snapshots (the public bucket); empty = local published/ folder.
CSP_PUBLISHED_BASE_URL=

# --- Repo tooling (optional): path to the Hermes vault note checked by `bun run check:env` ---
CSP_VAULT_NOTE=

# --- Video generation (Animate) ---
# Animate and Finalize run through the Higgsfield CLI (logged in with `higgsfield auth login`).
# Optional: path to the CLI binary (default: the npm package's bundled binary on Windows, `higgsfield` elsewhere).
HIGGSFIELD_CLI=

# Higgsfield API (console.higgsfield.ai): a separate, pay-per-use dollar balance, billed per request.
# This is NOT the Higgsfield CLI (`hf`), which runs on the higgsfield.ai plan's credits and has draft/finalize.
# Format: KEY_ID:KEY_SECRET. Used by scripts/higgsfield/index.ts. Set in your local .env.local (git-ignored).
HIGGSFIELD_KEY=

# --- Notion (optional; series import and name sync) ---
# The Notion key is entered in Settings → Notion and stored server-side in the app settings file.
# This variable is the fallback used when no key has been entered there. With neither, the app
# reads and writes nothing in Notion and projects live entirely in the app (ADR 0010).
NOTION_TOKEN=

# --- Review Room (series media home, V1S-275) ---
# Base URL of Review Room and an automation key restricted to the series' Review Room project
# (BWS hermes_keys: CREATIVE_STUDIO_PRO_REVIEW_ROOM_API_KEY). Locked folders belong to this key; keep it long-lived.
CSP_REVIEW_ROOM_URL=
CSP_REVIEW_ROOM_API_KEY=
# Shared RustFS Sharp image service. Uses its existing /process-image storage layout.
CSP_MEDIA_GATEWAY_URL=
CSP_MEDIA_GATEWAY_TOKEN=
CSP_MEDIA_GATEWAY_BUCKET=
# --- Repo tooling (optional): the Hermes vault folder `bun run skills:sync` copies the prompt skills from (default ../hermes-notebook-vault) ---
CSP_VAULT_DIR=


# --- Song analysis: the operator's Essentia service (Studio jobs: beats, energy, sections; needs app-vm's GPU) ---
ESSENTIA_API_URL=
ESSENTIA_API_KEY=

# --- Shot tags: the operator's caption gateway (Qwen3-VL on app-vm's GPU); the Agent's model captions when it is down ---
SCENE_CAPTION_SMART_GATEWAY_URL=
SCENE_CAPTION_SMART_GATEWAY_TOKEN=

# Where scripts/release-studio.sh releases the app (optional; default gordo@app-vm over Tailscale SSH).
# CSP_RELEASE_HOST=

# The address people open this copy at (adapter-node's own setting; Hosted Studio sets it to its https domain).
# The app also writes it into Review Room's locked folders as the link back; a copy without an https ORIGIN writes none.
ORIGIN=

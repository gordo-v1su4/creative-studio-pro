# Copy to .env.local and fill in values there. .env.local is git-ignored; this
# file lists variable names only (empty values). Set URLs, keys, and pins in your
# local .env.local (git-ignored).

# --- Operator (who may change projects) ---
CSP_OPERATOR_ID=
CSP_OPERATOR_TOKEN=

# --- Storage: folder holding data/projects (defaults to the repo root) ---
CSP_PROJECT_ROOT=
# Production build only (adapter-node): files dropped on the board upload as the request
# body, and adapter-node caps bodies at 512K by default. Raise it for video, e.g. 2G.
BODY_SIZE_LIMIT=

# --- Agent model provider ---
# Pick providers (Hyper, custom endpoint, Raycast bridge), keys and the app default
# in Settings → Agent model; keys are stored in the app settings file below, never in projects.
# Optional: where that file lives (default: app-settings.json beside CSP_PROJECT_ROOT, never inside it).
CSP_APP_SETTINGS_PATH=
# Optional: Hyper key fallback when none is saved in Settings.
HYPER_API_KEY=
# Fallback default when no app default is picked (OpenAI-compatible).
KIMI_API_KEY=
KIMI_API_BASE=
KIMI_MODEL=

# --- Raycast bridge (optional; operator's personal provider) ---
CSP_RAYCAST_BRIDGE_URL=
CSP_RAYCAST_BRIDGE_TOKEN=

# --- Splitter (scene-detect / grid split service) ---
CSP_SPLITTER_URL=
SPLITTER_APP_ACCESS_PIN=

# --- Settings → capability checks (optional) ---
CSP_DESKTOP_URL=

# --- Video generation (Animate) ---
# Animate and Finalize run through the Higgsfield CLI (logged in with `higgsfield auth login`).
# Optional: path to the CLI binary (default: the npm package's bundled binary on Windows, `higgsfield` elsewhere).
HIGGSFIELD_CLI=

# Higgsfield API (console.higgsfield.ai): a separate, pay-per-use dollar balance, billed per request.
# This is NOT the Higgsfield CLI (`hf`), which runs on the higgsfield.ai plan's credits and has draft/finalize.
# Format: KEY_ID:KEY_SECRET. Used by scripts/higgsfield/index.ts. Set in your local .env.local (git-ignored).
HIGGSFIELD_KEY=

# --- Notion (series import) ---
NOTION_TOKEN=

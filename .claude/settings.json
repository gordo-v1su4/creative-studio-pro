{
  "permissions": {
    "ask": [
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push * *:main*)",
      "Bash(scripts/release-studio.sh*)",
      "Bash(./scripts/release-studio.sh*)",
      "Bash(bash scripts/release-studio.sh*)",
      "Bash(sh scripts/release-studio.sh*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/check-env.ts\" 1>&2 || exit 2"
          }
        ]
      }
    ]
  }
}

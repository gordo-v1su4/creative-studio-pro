{
	"name": "creative-studio-pro",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"postinstall": "bun run skills:link",
		"skills:link": "bun run scripts/link-agent-skills.ts",
		"skills:install": "bunx skills@latest experimental_install -y",
		"skills:update": "bunx skills@latest update -p -y",
		"dev": "vite dev",
		"test": "bun test",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.2.0",
		"@webgpu/types": "^0.1.66",
		"svelte": "^5.56.10",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^3.0.35",
		"@ai-sdk/svelte": "^5.0.77",
		"@higgsfield/client": "^0.2.6",
		"@xyflow/svelte": "^1.6.3",
		"ai": "^7.0.77",
		"mediabunny": "^1.51.0",
		"zod": "^4.4.3"
	}
}
